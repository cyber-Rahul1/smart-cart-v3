{
  "expo": {
    "name": "GathrCart",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gathrcart",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.gathrcartdev.cvzmks",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add photos of your dishes and shop",
        "NSCameraUsageDescription": "Snap photos of your dishes and shop",
        "NSLocationWhenInUseUsageDescription": "Pin your door and share live delivery location"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.gathrcartdev.cvzmks",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pin your door and share live delivery location"
        }
      ],
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Add photos of your dishes and shop",
          "cameraPermission": "Snap photos of your dishes and shop"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}